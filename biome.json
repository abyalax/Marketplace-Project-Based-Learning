{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,css,md}",
      "**/*.{schema,repository,api}.ts",
      "!node_modules",
      "!.next",
      "!out",
      "!build",
      "!dist",
      "!drizzle",
      "!modules/cv",
      "!data/cv",
      "!prisma/data.ts",
      "!prisma/seeds/cv-seeder.ts",
      "!app/(authenticated)/client/\\[clientId\\]/cv/_components",
      "!app/(authenticated)/client/\\[clientId\\]/cv/_hooks",
      "!app/(authenticated)/client/\\[clientId\\]/analyze/_components",
      "!app/(authenticated)/client/\\[clientId\\]/analyze/_hooks",
      "!app/(public)/qrcode/\\[clientId\\]/\\[cvId\\]/_components",
      "!app/(public)/qrcode/\\[clientId\\]/\\[cvId\\]/_hooks",
      "!docs/examples/legacy-cv-pattern",
      "!.legacy-cv-pattern"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space",
    "bracketSpacing": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": "off",
      "correctness": {
        "useUniqueElementIds": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "recommended": true,
        "noArrayIndexKey": "off",
        "noUnknownAtRules": "off"
      },
      "style": {
        "useImportType": "off",
        "useFilenamingConvention": "off",
        "useShorthandAssign": "off",
        "useCollapsedElseIf": "on",
        "useNamingConvention": "off",
        "recommended": true
      }
    }
  },
  "css": {
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 130,
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,css,md}",
      "**/*.{schema,repository,api}.ts",
      "!node_modules",
      "!.next",
      "!out",
      "!build",
      "!dist",
      "!drizzle",
      "!modules/cv",
      "!data/cv",
      "!prisma/data.ts",
      "!prisma/seeds/cv-seeder.ts",
      "!app/(authenticated)/client/\\[clientId\\]/cv/_components",
      "!app/(authenticated)/client/\\[clientId\\]/cv/_hooks",
      "!app/(authenticated)/client/\\[clientId\\]/analyze/_components",
      "!app/(authenticated)/client/\\[clientId\\]/analyze/_hooks",
      "!app/(public)/qrcode/\\[clientId\\]/\\[cvId\\]/_components",
      "!app/(public)/qrcode/\\[clientId\\]/\\[cvId\\]/_hooks",
      "!docs/examples/legacy-cv-pattern",
      "!.legacy-cv-pattern"
    ],
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
